# Flowmate Environment Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ===========================================
# AI CLIENT SECURITY BOUNDARY
# ===========================================
# The local workspace and deterministic local rules work without Gemini.
# Privileged owner/billing API keys must NEVER be configured in VITE_* build
# variables, as Vite statically inlines them into downloadable browser bundles.
# Browser build variables are visible to application users. Never add a server
# credential or a key that grants privileged account or billing access here.


# ===========================================
# FIREBASE (Optional; required for cloud sync and authentication)
# ===========================================
# Get these from Firebase Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: reCAPTCHA v3 public site key for Firebase App Check.
# Register it in Firebase App Check before enabling server-side enforcement.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional: local/staging managed-AI endpoint override. Production otherwise
# derives the asia-south1 Functions URL from VITE_FIREBASE_PROJECT_ID.
VITE_MANAGED_AI_ENDPOINT=

# Optional: For analytics
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
