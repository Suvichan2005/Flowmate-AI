{
  "name": "flowmate",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:boundary": "node scripts/check_platform_boundary.mjs",
    "check:citations": "node scripts/check_citation_integrity.mjs",
    "check:invariants": "node scripts/run_all_invariants.mjs",
    "archive-intelligence:server": "node scripts/run_archive_intelligence.mjs",
    "archive-intelligence:discovery": "node scripts/run_archive_intelligence.mjs --discovery-only",
    "archive-intelligence:export": "node scripts/run_archive_intelligence.mjs --export-only",
    "archive-intelligence:full": "node scripts/run_archive_intelligence.mjs --full-run",
    "check:types": "tsc --noEmit",
    "release:scan": "node scripts/release_artifact_scan.mjs",
    "test:release": "vitest run --maxWorkers=2",
    "check:themes": "node scripts/check_theme_colors.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "d3": "^7.9.0",
    "firebase": "^12.6.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.5.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  }
}
